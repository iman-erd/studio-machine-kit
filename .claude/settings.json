{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(./bin/check)",
      "Bash(./bin/verify)",
      "Bash(./bin/intake:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(npm publish:*)",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(chmod 777:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "disableBypassPermissionsMode": "disable",
  "_let_op": "Test elke deny-regel eenmalig met een onschuldig geval. Een blokkade waarvan je niet weet of hij vastzit is erger dan geen blokkade. Zie M13."
}
